generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

model SchoolClass {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(255)
  code        String    @unique @db.VarChar(50)
  description String?
  sortOrder   Int       @default(0)
  isArchived  Boolean   @default(false)
  archivedAt  DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  books       Book[]

  @@map("classes")
}

model Book {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  book_name   String       @db.VarChar(255)
  description String?
  edition     String?      @db.VarChar(100)
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamp(6)
  /// Soft delete: set instead of removing the row, so chapters and questions
  /// survive and the book can be restored. Hidden from every public listing.
  deletedAt   DateTime?    @db.Timestamp(6)
  classId     String?      @db.Uuid
  class       SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapters    Chapter[]

  /// A book name appears at most once per class (deleted books included, so
  /// re-creating a deleted book means restoring it).
  @@unique([classId, book_name])
  @@index([classId])
  @@index([book_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_book_name_trgm_idx")
  @@map("books")
}

model Chapter {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chapter_name   String          @db.VarChar(255)
  order          Int
  description    String?
  createdAt      DateTime        @default(now()) @db.Timestamp(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  bookId         String          @db.Uuid
  book           Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  questions      LongQuestion[]
  shortQuestions ShortQuestion[]
  mcqQuestions   McqQuestion[]

  @@index([bookId])
  @@index([chapter_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "chapters_chapter_name_trgm_idx")
  @@map("chapters")
}

model LongQuestion {
  id             String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_text  String             @db.Text
  questionTextUr String?            @db.Text
  marks          Int                @default(5)
  difficulty     QuestionDifficulty @default(medium)
  createdAt      DateTime           @default(now()) @db.Timestamp(6)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  chapterId      String             @db.Uuid
  chapter        Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, question_text])
  @@index([question_text(ops: raw("gin_trgm_ops"))], type: Gin, map: "long_questions_question_text_trgm_idx")
  @@index([questionTextUr(ops: raw("gin_trgm_ops"))], type: Gin, map: "long_questions_question_text_ur_trgm_idx")
  @@map("long_questions")
}

model ShortQuestion {
  id             String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_text  String             @db.Text
  questionTextUr String?            @db.Text
  marks          Int                @default(2)
  difficulty     QuestionDifficulty @default(medium)
  createdAt      DateTime           @default(now()) @db.Timestamp(6)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  chapterId      String             @db.Uuid
  chapter        Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, question_text])
  @@index([question_text(ops: raw("gin_trgm_ops"))], type: Gin, map: "short_questions_question_text_trgm_idx")
  @@index([questionTextUr(ops: raw("gin_trgm_ops"))], type: Gin, map: "short_questions_question_text_ur_trgm_idx")
  @@map("short_questions")
}

model McqQuestion {
  id             String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_text  String             @db.Text
  questionTextUr String?            @db.Text
  options        Json
  marks          Int                @default(1)
  difficulty     QuestionDifficulty @default(medium)
  createdAt      DateTime           @default(now()) @db.Timestamp(6)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  chapterId      String             @db.Uuid
  chapter        Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, question_text])
  @@index([question_text(ops: raw("gin_trgm_ops"))], type: Gin, map: "mcq_questions_question_text_trgm_idx")
  @@index([questionTextUr(ops: raw("gin_trgm_ops"))], type: Gin, map: "mcq_questions_question_text_ur_trgm_idx")
  @@map("mcq_questions")
}

model User {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String        @db.VarChar(255)
  email                String        @unique @db.VarChar(255)
  password             String        @db.VarChar(255)
  otp                  String?       @db.VarChar(255)
  otpExpiresAt         DateTime?     @db.Timestamptz(6)
  /// Failed login-OTP attempts since the last OTP was issued / lockout ended.
  otpFailedAttempts    Int           @default(0)
  otpLockedUntil       DateTime?     @db.Timestamptz(6)
  resetOtp             String?       @db.VarChar(255)
  resetOtpExpiresAt    DateTime?     @db.Timestamptz(6)
  /// Failed password-reset code attempts for the current reset code.
  resetOtpAttempts     Int           @default(0)
  /// Per-account password-reset limits (independent of client IP): start of
  /// the current window, reset emails sent and wrong codes entered in it.
  resetWindowStartedAt DateTime?     @db.Timestamptz(6)
  resetRequestCount    Int           @default(0)
  resetFailedCount     Int           @default(0)
  resetLastSentAt      DateTime?     @db.Timestamptz(6)
  roleId               String?       @db.Uuid
  isSuspended          Boolean       @default(false)
  role                 UserRole?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions             AuthSession[]

  @@map("user")
}

/// One row per signed-in device/browser. The refresh token rotates inside the
/// session; presenting an older (already rotated) token outside the grace
/// window is treated as token theft and revokes the whole session.
model AuthSession {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @db.VarChar(64)
  previousTokenHash String?   @db.VarChar(64)
  previousRotatedAt DateTime? @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  revokedReason     String?   @db.VarChar(50)
  userAgent         String?   @db.VarChar(255)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model UserRole {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  role_name String @unique @db.VarChar(255)
  users     User[]

  @@map("user_role")
}
