PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/testora
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Use none if the web app and API are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Testora <noreply@localhost>
# Development only. Never enable in production. Password must be 12+ characters.
AUTH_SEED=false
AUTH_SEED_PASSWORD=
AUTH_SEED_SUPERADMIN_EMAIL=superadmin@localhost
AUTH_SEED_ADMIN_EMAIL=admin@localhost
