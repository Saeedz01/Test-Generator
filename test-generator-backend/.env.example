# -----------------------------------------------------------------------------
# Testora backend configuration. Copy to .env and fill in.
# Validated at boot (src/config/env.validation.ts): the app refuses to start
# with a clear error listing every invalid/missing key.
# -----------------------------------------------------------------------------

# REQUIRED. Runtime environment: development | production | test.
# There is no default: servers must set NODE_ENV=production.
NODE_ENV=development
# HTTP port the API listens on (default 5000)
PORT=5000

# Database Configuration
# REQUIRED. PostgreSQL connection string (the uuid-ossp extension is created by
# the baseline migration; the DB user needs permission to create it once).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public
# Informational only (not read by the app; DATABASE_URL is authoritative)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Server Configuration (informational only, not read by the app)
SERVER_PORT=
SERVER_HOST=
SERVER_PROTOCOL=
SERVER_URL=
SERVER_ENV=
SERVER_NAME=
SERVER_VERSION=
SERVER_DESCRIPTION=
SERVER_AUTHOR=
SERVER_AUTHOR_EMAIL=
SERVER_AUTHOR_URL=

# -----------------------------------------------------------------------------
# JWT — REQUIRED in every environment (only NODE_ENV=test may omit them).
# Each secret: >= 32 characters, random, and the two must differ.
# Generate each one with:   openssl rand -hex 32
# In production, human-chosen values (containing words like "secret",
# "change", "password", "example") are rejected.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durations: <number><s|m|h|d>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# HTTP / cookies / proxy
# -----------------------------------------------------------------------------
# Comma-separated frontend origins allowed for CORS and for the CSRF origin
# check on cookie-authenticated POST/PUT/PATCH/DELETE. REQUIRED in production,
# where they must be https:// (localhost excepted).
# Bare origins only, e.g. https://app.example.com (no trailing slash/path).
CORS_ORIGINS=http://localhost:3000
# lax (default) | strict | none. "none" forces Secure cookies and is only needed
# if the frontend and API are on different registrable domains (not recommended).
COOKIE_SAMESITE=lax
# Optional parent domain for auth cookies, e.g. example.com, so an API on
# api.example.com and a frontend on example.com / app.example.com share them.
# Leave empty when the frontend proxies /api to this backend (Next rewrite)
# or when both run on the same host.
COOKIE_DOMAIN=
# Reverse proxies in front of the API (express "trust proxy"); decides the
# client IP used for rate limiting and logs. REQUIRED in production:
#   1 (or 2, ...)          number of proxies (nginx / load balancer) in front
#   10.0.0.0/8,127.0.0.1   comma-separated trusted proxy IPs/subnets
#   false                  clients connect to the API directly
# "true" is rejected in production (clients could spoof X-Forwarded-For).
# Defaults to false outside production.
TRUST_PROXY=false
# Global rate limit per client IP (auth routes have stricter fixed limits).
# In-memory store: limits are per process/instance.
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000

# -----------------------------------------------------------------------------
# Mail (login OTPs and password-reset codes are sent by email)
# MAIL_ENABLED defaults to true in production (where it MUST be true) and false
# otherwise. When false in development, login OTPs are printed to the server log.
# When true: MAIL_HOST, MAIL_USER (or MAIL_USERNAME) and MAIL_PASSWORD are
# required; MAIL_FROM is also required in production.
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
# 587 (STARTTLS, default) or 465 (implicit TLS)
MAIL_PORT=587
# true for port 465; defaults to (MAIL_PORT == 465)
MAIL_SECURE=
MAIL_USER=
MAIL_USERNAME=
MAIL_PASSWORD=
# Required in production; the example.com placeholder is rejected there.
MAIL_FROM="Testora <noreply@example.com>"
MAIL_FROM_NAME=
# Login OTP lifetime in minutes (1-60, default 5)
OTP_EXPIRES_IN_MINUTES=5

# -----------------------------------------------------------------------------
# Development seed accounts (ignored when NODE_ENV=production).
# Create-only: existing accounts are never modified, other super admins are
# never deleted. Missing/invalid values only log a warning and skip seeding.
# Passwords must be at least 12 characters.
# -----------------------------------------------------------------------------
AUTH_SEED=false
AUTH_SEED_SUPER_ADMIN_EMAIL=
AUTH_SEED_SUPER_ADMIN_PASSWORD=
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Curriculum seed script (npm run prisma:seed) — not read by the API.
# SEED_RESET=true (or --reset) wipes ALL classes/books/chapters/questions first.
# With NODE_ENV=production the script refuses to run unless
# SEED_ALLOW_DESTRUCTIVE=true (or --force).
# -----------------------------------------------------------------------------
SEED_RESET=false
SEED_ALLOW_DESTRUCTIVE=false
